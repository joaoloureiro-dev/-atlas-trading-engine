{
  "name": "atlas-trading-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Secure autonomous multi-market AI trading platform",
  "workspaces": [
    "apps/*",
    "apps/agents/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
