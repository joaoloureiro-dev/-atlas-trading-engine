generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum IdentityProvider {
  PRIVY
}

enum BrokerType {
  BROKER
  EXCHANGE
}

enum BrokerConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  DISCONNECTED
  REVOKED
}

enum BrokerAccountStatus {
  ACTIVE
  RESTRICTED
  DISABLED
}

enum TradingMode {
  PAPER
  SHADOW
  LIVE
}

// ============================================================
// IDENTITY & MULTI-TENANCY
// ============================================================

model User {
  id        String     @id @default(uuid()) @db.Uuid
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  identities  ExternalIdentity[]
  memberships TenantMembership[]

  @@index([status])
  @@map("users")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships       TenantMembership[]
  brokerConnections BrokerConnection[]
  brokerAccounts    BrokerAccount[]

  @@index([status])
  @@map("tenants")
}

model TenantMembership {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model ExternalIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("external_identities")
}

// ============================================================
// BROKERS & EXCHANGES
// ============================================================

model BrokerConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  provider String
  type     BrokerType

  status BrokerConnectionStatus @default(PENDING)

  // Reference to credentials stored in the secrets infrastructure.
  // API keys and secrets must NEVER be stored here in plaintext.
  credentialReference String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts BrokerAccount[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, provider])
  @@map("broker_connections")
}

model BrokerAccount {
  id                 String @id @default(uuid()) @db.Uuid
  tenantId           String @db.Uuid
  brokerConnectionId String @db.Uuid

  externalAccountId String

  status      BrokerAccountStatus @default(ACTIVE)
  tradingMode TradingMode         @default(PAPER)

  baseCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  brokerConnection BrokerConnection @relation(fields: [tenantId, brokerConnectionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([brokerConnectionId, externalAccountId])
  @@index([tenantId, status])
  @@index([tenantId, tradingMode])
  @@index([tenantId, brokerConnectionId])
  @@map("broker_accounts")
}
