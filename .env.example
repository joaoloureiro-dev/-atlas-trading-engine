NODE_ENV=development

TRADING_MODE=paper

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt,es,fr

PRIVY_APP_ID=
PRIVY_APP_SECRET=

POSTGRES_USER=atlas
# Set strong, unique passwords. Docker Compose refuses to start without one.
POSTGRES_PASSWORD=
POSTGRES_DB=atlas_dev

POSTGRES_APP_USER=atlas_app
POSTGRES_APP_PASSWORD=

# Replace PASSWORD and APP_PASSWORD with the values above.
DATABASE_URL=postgresql://atlas:PASSWORD@localhost:5432/atlas_dev?schema=public
APP_DATABASE_URL=postgresql://atlas_app:APP_PASSWORD@localhost:5432/atlas_dev?schema=public